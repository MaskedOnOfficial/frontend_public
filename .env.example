# Public web app URL (used for share links)
VITE_APP_URL=https://your-netlify-app.netlify.app

# Backend API base URL (must include /api/v1)
VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1

# Backend WebSocket URL for notifications
VITE_WS_URL=https://your-render-service.onrender.com

# Supabase auth client config (for password recovery token handling)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
